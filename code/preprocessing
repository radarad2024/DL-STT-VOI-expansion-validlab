"""Preprocessing and data loading shared by internal and external validation.

Pipeline applied to every case (identical for the R-VOI, S-VOI, and E-VOI models):
  1. Load the three MRI sequences (contrast-enhanced T1WI, T1WI, T2WI) and the VOI mask
     of each sequence (the tumor is segmented on each sequence separately).
  2. Resample the whole image volume to 1 x 1 x 2 mm.
  3. Resize the whole image volume to 128 x 128 x 80 voxels.
  4. Apply the VOI mask of each sequence to that sequence (voxels outside the VOI are
     set to 0). Images are not cropped to the VOI.
  5. Normalize intensities within the VOI: f(x) = (x - mean) / SD x 1000.
  6. Training only: random flipping, affine transformation, Gaussian noise,
     bias field, and elastic deformation.

Expected data layout (one directory per VOI type; see README.md):
    <voi_dir>/EN/<patient_id>/<image>.nii.gz   contrast-enhanced T1WI
    <voi_dir>/EN/<patient_id>/seg*.nii.gz      VOI mask on contrast-enhanced T1WI
    <voi_dir>/T1/<patient_id>/<image>.nii.gz   T1WI
    <voi_dir>/T1/<patient_id>/seg*.nii.gz      VOI mask on T1WI
    <voi_dir>/T2/<patient_id>/<image>.nii.gz   T2WI
    <voi_dir>/T2/<patient_id>/seg*.nii.gz      VOI mask on T2WI

Quick check of one VOI directory:
    python preprocessing.py --data_dir ./data/train/S-VOI --labels ./data/train/labels.csv
"""
import os
import argparse

import numpy as np
import pandas as pd
from torch.utils.data.dataloader import default_collate
from monai.data import Dataset as MonaiDataset
from monai.transforms import (
    Compose, LoadImaged, EnsureChannelFirstd, Spacingd, Resized,
    MaskIntensityd, RandFlipd, RandAffined, RandGaussianNoised,
    RandBiasFieldd, Rand3DElasticd, ToTensord, MapTransform,
)

# ── Preprocessing parameters ──
SPACING = (1.0, 1.0, 2.0)      # mm
ROI_SIZE = (128, 128, 80)      # voxels

VOI_NAMES = ["R-VOI", "S-VOI", "E-VOI"]
IMG_KEYS = ["en_img", "t1_img", "t2_img"]
SEG_KEYS = ["en_lbl", "t1_lbl", "t2_lbl"]
ALL_KEYS = IMG_KEYS + SEG_KEYS


# ── Intensity normalization ──
class IntensityNormalization(MapTransform):
    """f(x) = (x - mean) / std * 1000, computed on nonzero voxels only.

    The transform is applied after the VOI mask, so the mean and standard
    deviation are calculated within the VOI.
    """
    def __init__(self, keys, allow_missing_keys=False):
        super().__init__(keys, allow_missing_keys)

    def __call__(self, data):
        d = dict(data)
        for key in self.keys:
            img = d[key]
            mask = img > 0
            if mask.sum() > 0:
                mu, sigma = img[mask].mean(), img[mask].std()
                if sigma > 0:
                    img = np.where(mask, (img - mu) / sigma * 1000, 0)
            d[key] = img
        return d


# ── Transforms ──
def get_transforms(train=True):
    """Preprocessing transforms. Augmentation is added only when train=True."""
    t = [
        LoadImaged(keys=ALL_KEYS, image_only=True),
        EnsureChannelFirstd(keys=ALL_KEYS),
        Spacingd(keys=ALL_KEYS, pixdim=SPACING, mode=["bilinear"]*3 + ["nearest"]*3),
        Resized(keys=ALL_KEYS, spatial_size=ROI_SIZE, mode=["trilinear"]*3 + ["nearest"]*3),
        MaskIntensityd(keys="en_img", mask_key="en_lbl"),   # each sequence is masked with its own VOI
        MaskIntensityd(keys="t1_img", mask_key="t1_lbl"),
        MaskIntensityd(keys="t2_img", mask_key="t2_lbl"),
        IntensityNormalization(keys=IMG_KEYS),
    ]
    if train:
        t += [
            RandFlipd(keys=ALL_KEYS, prob=0.5, spatial_axis=0),
            RandFlipd(keys=ALL_KEYS, prob=0.5, spatial_axis=1),
            RandAffined(keys=ALL_KEYS, mode=["bilinear"]*3+["nearest"]*3,
                        prob=0.8, rotate_range=[0.1]*3, translate_range=[10,10,5], scale_range=[0.1]*3),
            RandGaussianNoised(keys=IMG_KEYS, prob=0.3, mean=0.0, std=0.1),
            RandBiasFieldd(keys=IMG_KEYS, prob=0.2, degree=3, coeff_range=(0.0, 0.1)),
            Rand3DElasticd(keys=ALL_KEYS, prob=0.1, sigma_range=(5,8), magnitude_range=(100,200),
                           spatial_size=ROI_SIZE, mode=["bilinear"]*3+["nearest"]*3),
        ]
    t.append(ToTensord(keys=IMG_KEYS))
    return Compose(t)


# ── Data loading ──
def load_labels(path):
    """labels.csv with columns patient_id, label (0 = non-malignant, 1 = malignant)."""
    df = pd.read_csv(path, dtype={"patient_id": str})
    return df.set_index("patient_id")["label"].astype(int).to_dict()


def build_file_list(data_dir, labels):
    """Collect patients that have all three sequences and the VOI mask of each sequence."""
    seq_dirs = {"en": None, "t1": None, "t2": None}
    for d in os.listdir(data_dir):
        name = d.lower()
        for seq in seq_dirs:
            if seq in name and not seq_dirs[seq]:
                seq_dirs[seq] = os.path.join(data_dir, d)
    items = []
    for pid in os.listdir(seq_dirs["en"]):
        if pid not in labels:
            continue
        paths = {}
        valid = True
        for seq in ["en", "t1", "t2"]:
            p = os.path.join(seq_dirs[seq], pid)
            if not os.path.isdir(p):
                valid = False; break
            files = [f for f in os.listdir(p) if f.endswith(".nii.gz")]
            paths[seq] = next((os.path.join(p, f) for f in files if not f.startswith("seg")), None)
            paths[f"{seq}_seg"] = next((os.path.join(p, f) for f in files if f.startswith("seg")), None)
        if valid and all(paths.get(k) for k in ["en", "t1", "t2", "en_seg", "t1_seg", "t2_seg"]):
            items.append({"patient_id": pid, **paths})
    print(f"Found {len(items)} patients")
    return items


def prepare_dict(item, labels):
    return {"en_img": item["en"], "t1_img": item["t1"], "t2_img": item["t2"],
            "en_lbl": item["en_seg"], "t1_lbl": item["t1_seg"], "t2_lbl": item["t2_seg"],
            "label": labels[item["patient_id"]], "patient_id": item["patient_id"]}


class SafeDataset(MonaiDataset):
    """Returns None for a case that cannot be loaded; collate_fn drops it."""
    def __getitem__(self, idx):
        try:
            return super().__getitem__(idx)
        except Exception:
            return None


def collate_fn(batch):
    batch = [b for b in batch if b is not None]
    return default_collate(batch) if batch else None


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description="Check the preprocessing of one VOI directory.")
    ap.add_argument("--data_dir", default="./data/train/S-VOI")
    ap.add_argument("--labels", default="./data/train/labels.csv")
    args = ap.parse_args()

    labels = load_labels(args.labels)
    items = build_file_list(args.data_dir, labels)
    sample = get_transforms(train=False)(prepare_dict(items[0], labels))
    for k in IMG_KEYS:
        img = sample[k]
        voi = img != 0
        print(f"{k}: shape={tuple(img.shape)}, VOI fraction={float(voi.float().mean()):.4f}, "
              f"mean in VOI={float(img[voi].mean()):.2f}, SD in VOI={float(img[voi].std()):.2f}")
